generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DRIVER
  FLEET_MANAGER
  BUSINESS_OWNER
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

model User {
  id        String   @id @default(uuid())
  role      Role     @default(DRIVER)
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Hierarchical relationship: e.g., Driver -> Fleet Manager -> Business Owner
  managerId    String?
  manager      User?   @relation("UserHierarchy", fields: [managerId], references: [id])
  subordinates User[]  @relation("UserHierarchy")

  // Assigned vehicles (Many-to-Many mapping)
  vehicles Vehicle[] @relation("UserVehicles")

  // User preferences and settings
  settings UserSettings?
}

model UserSettings {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  theme Theme @default(SYSTEM)

  // Dashboard & Tracking preferences
  liveData             Boolean @default(true)
  pollingInterval      Int     @default(5000) // Polling interval in milliseconds
  autoRefreshAnalytics Boolean @default(true)
  autoRefreshAlerts    Boolean @default(true)

  // Scalable widget configurations (stores enabled/disabled state of widgets per page)
  widgets Json? @default("{\"dashboard\": {\"showMap\": true}}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vehicle {
  id        String   @id
  status    String
  health    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  telemetry Telemetry[]
  users     User[]      @relation("UserVehicles")
  alerts    Alert[]
}

model Telemetry {
  id         String   @id @default(uuid())
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id])
  timestamp  DateTime
  speed      Float
  fuelLevel  Float
  engineTemp Float
  status     String
  health     String
  eventType  String
  lat        Float
  lng        Float

  @@index([timestamp])
  @@index([vehicleId, timestamp])
}

model Alert {
  id           String   @id @default(uuid())
  vehicleId    String
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id])
  type         String
  message      String
  severity     String   @default("CRITICAL")
  acknowledged Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([vehicleId])
}
